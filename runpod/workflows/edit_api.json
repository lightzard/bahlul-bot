{
  "10": {
    "class_type": "UnetLoaderGGUF",
    "inputs": {
      "unet_name": "qwen-image-2.1-Q4_K_M.gguf"
    },
    "_note": "GGUF loader from leejet/ComfyUI-GGUF (city96's version rejects this model)"
  },
  "20": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["10", 0],
      "lora_name": "qwen-lora.safetensors",
      "strength_model": 1.0
    },
    "_note": "Optional LoRA; the handler removes this node and rewires the model input when MODEL_LORA is unset. Applied before QwenImage21Cache so patches land on the weights first."
  },
  "11": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
      "type": "qwen_image",
      "device": "cpu"
    }
  },
  "12": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
    }
  },
  "18": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input.jpg"
    }
  },
  "13": {
    "class_type": "TextEncodeQwenImage21",
    "inputs": {
      "clip": ["11", 0],
      "vae": ["12", 0],
      "prompt": "",
      "negative_prompt": "",
      "resolution": 1024,
      "images.image_1": ["18", 0]
    }
  },
  "19": {
    "class_type": "QwenImage21Cache",
    "inputs": {
      "model": ["20", 0],
      "device": "auto",
      "dtype": "default"
    }
  },
  "15": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["19", 0],
      "positive": ["13", 0],
      "negative": ["13", 1],
      "latent_image": ["13", 2],
      "seed": 0,
      "steps": 25,
      "cfg": 1.0,
      "sampler_name": "er_sde",
      "scheduler": "beta",
      "denoise": 1.0
    },
    "_note": "er_sde + beta + 25 steps is the required recipe; latent comes from TextEncodeQwenImage21 output 2 (latent sized to the reference image)"
  },
  "16": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["15", 0],
      "vae": ["12", 0]
    }
  },
  "17": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["16", 0],
      "filename_prefix": "qwen_image_edit"
    }
  }
}
